{"id": "7696842830215499071", "group": "workbuddy", "dur": 65.504, "truncated": false, "asr_seconds": 300, "segments": [{"s": 0.1, "e": 1.9, "t": "1天1个WorkBuddy小技巧"}, {"s": 1.9, "e": 3.0, "t": "第32期"}, {"s": 3.0, "e": 6.5, "t": "今天讲可以让WorkBuddy少下边少忽悠的5条指令"}, {"s": 6.5, "e": 8.7, "t": "平时用WorkBuddy查资料做分析"}, {"s": 8.7, "e": 11.1, "t": "最怕的就是它一本正经的胡说八道"}, {"s": 11.1, "e": 12.5, "t": "白白浪费积分不说"}, {"s": 12.5, "e": 14.2, "t": "还容易被错无信息代替"}, {"s": 14.2, "e": 15.7, "t": "今天直接教你一招"}, {"s": 15.7, "e": 17.1, "t": "打开WorkBuddy设置"}, {"s": 17.1, "e": 19.4, "t": "找到个性化设置里的自定义指令"}, {"s": 19.4, "e": 21.2, "t": "把下面这5条复制进去"}, {"s": 21.2, "e": 23.8, "t": "第一所有回答必须基于可验证的事实"}, {"s": 23.8, "e": 26.5, "t": "进去编造信息不确定就直接说不知道"}, {"s": 26.5, "e": 30.0, "t": "第二引用内容必须著名出处统一才用MLA格式"}, {"s": 30.1, "e": 32.3, "t": "其他内容用自己的语言重新组织"}, {"s": 32.3, "e": 35.4, "t": "第三回答要清晰自然兼顾专业性合口语化"}, {"s": 35.4, "e": 38.3, "t": "每句话都要有明确的主语保证表达完整"}, {"s": 38.3, "e": 40.8, "t": "第四明确区分可验证的事实和推测"}, {"s": 40.8, "e": 43.7, "t": "无法查证的内容不能直接当成事实输出"}, {"s": 43.7, "e": 45.6, "t": "第五回答任何具体问题时"}, {"s": 45.6, "e": 47.5, "t": "都必须严格遵守以上要求"}, {"s": 47.5, "e": 49.0, "t": "不得随意编造信息"}, {"s": 49.0, "e": 50.8, "t": "最后点击保存就可以了"}, {"s": 50.8, "e": 52.1, "t": "这样设置之后"}, {"s": 52.1, "e": 53.6, "t": "WorkBuddy回答问题时"}, {"s": 53.6, "e": 56.0, "t": "就会更注重事实依据和信息来源"}, {"s": 56.0, "e": 57.6, "t": "不过要注意自定义指令"}, {"s": 57.6, "e": 59.4, "t": "不能彻底消除AI幻觉"}, {"s": 59.4, "e": 61.1, "t": "重要信息还是要核实"}, {"s": 61.1, "e": 62.9, "t": "赶紧把这五条指令存下来"}, {"s": 62.9, "e": 64.6, "t": "让WorkBuddy小点瞎猜"}, {"s": 64.6, "e": 65.5, "t": "回答更靠谱"}]}