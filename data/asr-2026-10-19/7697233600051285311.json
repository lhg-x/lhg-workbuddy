{"id": "7697233600051285311", "group": "leviiii2026", "dur": 45, "truncated": false, "asr_seconds": 300, "segments": [{"s": 0.0, "e": 3.6, "t": "分享一个逆天好用却很少有人知道的冷门神器"}, {"s": 3.6, "e": 5.4, "t": "记住名字叫Skillry"}, {"s": 5.4, "e": 9.2, "t": "全网所有用Cloud Opus 5.5模型做出来的炫酷视频"}, {"s": 9.2, "e": 10.8, "t": "你都能在这里找到"}, {"s": 10.8, "e": 13.4, "t": "而且每一条都附带完整的提示词"}, {"s": 13.4, "e": 14.6, "t": "能够直接复制"}, {"s": 14.6, "e": 19.4, "t": "就连让马斯克直呼AGI来临的那条高级感审美的AI音乐MV"}, {"s": 19.4, "e": 21.4, "t": "提示词也在这里全部公开了"}, {"s": 21.4, "e": 28.0, "t": "它的提示词里竟然没有任何关于画面、分镜、动作等等这种详细的参数描述"}, {"s": 28.0, "e": 34.6, "t": "也就是说这条视频的风格和审美以及这种高级感完全是由5.5模型自己把控的"}, {"s": 34.6, "e": 37.0, "t": "这个效果只能用牛来形容"}, {"s": 37.0, "e": 39.8, "t": "以后真的不用再研究复杂的提示词了"}, {"s": 39.8, "e": 41.0, "t": "专注好创意"}, {"s": 41.0, "e": 42.8, "t": "放心地交给AI去执行吧"}, {"s": 42.8, "e": 44.6, "t": "它的审美已经足够好了"}]}