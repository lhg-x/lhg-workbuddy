{"id": "7694911978590063926", "group": "workbuddy", "dur": 54.335, "truncated": false, "asr_seconds": 300, "segments": [{"s": 0.0, "e": 2.9, "t": "什么牌子啊 妈妈 连我和Buddy都不会用"}, {"s": 2.9, "e": 4.9, "t": "叫WorkBuddy一般般呀"}, {"s": 4.9, "e": 6.3, "t": "这三个如果不设置"}, {"s": 6.3, "e": 9.1, "t": "那你的OrgBuddy连一般的功能都发挥不出来"}, {"s": 9.1, "e": 10.3, "t": "尤其是最后一个"}, {"s": 10.3, "e": 10.8, "t": "安排"}, {"s": 11.8, "e": 13.7, "t": "首先点击左下角的头像"}, {"s": 13.7, "e": 15.2, "t": "然后点击设置"}, {"s": 15.2, "e": 16.8, "t": "找到技能自动更新"}, {"s": 16.8, "e": 17.8, "t": "把它打开"}, {"s": 17.8, "e": 21.6, "t": "它可以把你下载和安装的技能和skill自动更新"}, {"s": 21.6, "e": 23.7, "t": "第二个 找到允许索平运行"}, {"s": 23.7, "e": 25.3, "t": "这个一定要确认开启"}, {"s": 25.3, "e": 28.6, "t": "它是能够帮助你在远层操控你的OrgBuddy工作"}, {"s": 28.6, "e": 30.9, "t": "第三个 找到默认空间目录"}, {"s": 30.9, "e": 32.3, "t": "它默认是在C盘的"}, {"s": 32.3, "e": 33.1, "t": "干不了多久"}, {"s": 33.1, "e": 35.0, "t": "你的C盘空间就被干没了"}, {"s": 35.0, "e": 38.6, "t": "我们直接把它改为C盘以外的其他磁盘就搞定了"}, {"s": 38.6, "e": 40.9, "t": "第四个 点击优化体验优化计划"}, {"s": 40.9, "e": 42.0, "t": "把它也关闭"}, {"s": 42.0, "e": 43.8, "t": "因为它会收集你的个人信息"}, {"s": 43.8, "e": 46.4, "t": "还有你的个人项目数据等等去做优化"}, {"s": 46.4, "e": 48.6, "t": "毕竟切磁到你的个人隐私嘛"}, {"s": 48.6, "e": 50.8, "t": "所以建议大家都可以先关闭哈"}, {"s": 50.8, "e": 52.0, "t": "这几个设置完成之后"}, {"s": 52.0, "e": 54.0, "t": "绝对让它的工作效率直接方倍"}]}