{"id": "7689144680109428006", "group": "workbuddy", "dur": 60.581, "truncated": false, "asr_seconds": 300, "segments": [{"s": 0.1, "e": 1.9, "t": "一天一个WorkBuddy小技巧"}, {"s": 1.9, "e": 2.9, "t": "第十三期"}, {"s": 2.9, "e": 5.0, "t": "今天将把手机和电脑连起来"}, {"s": 5.0, "e": 7.5, "t": "以后离开公卫也能遥控AI干活"}, {"s": 7.5, "e": 9.7, "t": "第一步先把手机和电脑连起来"}, {"s": 9.7, "e": 12.1, "t": "想实现这个功能先确认两个版本"}, {"s": 12.1, "e": 13.5, "t": "手机端1.2.0"}, {"s": 13.5, "e": 15.3, "t": "加电脑端5.3.8加"}, {"s": 15.3, "e": 17.3, "t": "然后两边登陆同一个账号"}, {"s": 17.3, "e": 18.5, "t": "这里不用扫码"}, {"s": 18.5, "e": 20.1, "t": "也不用折腾蓝牙配对"}, {"s": 20.1, "e": 22.1, "t": "电脑端把移动端连接打开"}, {"s": 22.1, "e": 24.5, "t": "手机就能直接看到电脑上的任务"}, {"s": 24.5, "e": 26.5, "t": "第二步手机直接当遥控器用"}, {"s": 26.5, "e": 29.5, "t": "AI正在处理什么做到哪一步都能随时查看"}, {"s": 29.5, "e": 30.9, "t": "发现他理解错了"}, {"s": 30.9, "e": 32.5, "t": "也不用急着跑回电脑"}, {"s": 32.5, "e": 35.7, "t": "手机直接终止当前任务改好要求再重新执行"}, {"s": 35.7, "e": 38.3, "t": "避免AI一直跑下去白白消耗token"}, {"s": 38.3, "e": 41.1, "t": "第三步电脑生成的文件自动回到手机"}, {"s": 41.1, "e": 44.1, "t": "像worldxlppg图片这些AI生成的结果"}, {"s": 44.1, "e": 46.1, "t": "处理完之后手机端就能收到"}, {"s": 46.1, "e": 48.5, "t": "比如临时在外面拿到一张发票"}, {"s": 48.5, "e": 51.3, "t": "直接交给WorkBuddy电脑在办公室继续处理"}, {"s": 51.3, "e": 53.1, "t": "你在手机上就能等结果"}, {"s": 53.1, "e": 54.5, "t": "这波连上之后"}, {"s": 54.5, "e": 57.1, "t": "WorkBuddy基本就能随时随地接着干活了"}, {"s": 57.1, "e": 59.3, "t": "还有哪些WorkBuddy的隐藏玩法"}, {"s": 59.3, "e": 60.5, "t": "后面继续给你们吧"}]}