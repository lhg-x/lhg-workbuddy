{"id": "7672673583188987136", "group": "workbuddy", "dur": 61.068, "truncated": false, "asr_seconds": 300, "segments": [{"s": 0.0, "e": 3.8, "t": "让WorkBuddy用上这个模型你就能够无限白皮套"}, {"s": 3.8, "e": 5.4, "t": "它可不是烂大街的模型"}, {"s": 5.4, "e": 7.8, "t": "是可以直接对比较顶级的模型"}, {"s": 7.8, "e": 11.0, "t": "用上它之后你就可以让它帮你生成视频"}, {"s": 11.0, "e": 12.8, "t": "生成图、生成文字"}, {"s": 12.8, "e": 15.0, "t": "只需要两步看完就能学会"}, {"s": 15.0, "e": 16.8, "t": "第一步进入到这个界面"}, {"s": 16.8, "e": 18.6, "t": "点击创建新的密钥"}, {"s": 18.6, "e": 19.6, "t": "天显名称"}, {"s": 19.6, "e": 21.8, "t": "然后复制这个key一会需要"}, {"s": 21.8, "e": 23.6, "t": "第二步打开WorkBuddy"}, {"s": 23.6, "e": 24.5, "t": "打开设置"}, {"s": 24.5, "e": 26.4, "t": "选择模型、添加模型"}, {"s": 26.4, "e": 28.4, "t": "然后提供商选自定义"}, {"s": 28.4, "e": 29.1, "t": "接受地址"}, {"s": 29.1, "e": 31.5, "t": "点这个key 添写刚才复制的"}, {"s": 31.5, "e": 33.8, "t": "模型名称先添写文本模型"}, {"s": 33.8, "e": 35.5, "t": "写ngs 2.5pro"}, {"s": 35.5, "e": 37.3, "t": "然后我们回到对话"}, {"s": 37.3, "e": 39.8, "t": "在对话框里边选择刚才的模型"}, {"s": 39.8, "e": 41.4, "t": "然后发一段话"}, {"s": 41.4, "e": 44.3, "t": "它正确回复消息了就代表配置成功了"}, {"s": 44.3, "e": 46.8, "t": "如果想使用图片模型和视频模型"}, {"s": 46.8, "e": 49.1, "t": "就不能直接在WorkBuddy去配置"}, {"s": 49.1, "e": 50.5, "t": "因为它有刻刻端限制"}, {"s": 50.5, "e": 51.9, "t": "你可以用这个提示词"}, {"s": 51.9, "e": 53.4, "t": "它就会生成一张图"}, {"s": 53.4, "e": 55.6, "t": "同理视频可以发这段提示词"}, {"s": 55.6, "e": 58.1, "t": "如果返回视频了就代表你成功了"}, {"s": 58.1, "e": 58.8, "t": "如果你还不懂"}, {"s": 58.8, "e": 59.8, "t": "可以参考这个文档"}, {"s": 59.8, "e": 60.9, "t": "666可以叫一下"}]}